# Njangui Mobile — Environment Variables
# Copy to .env.local for local overrides (never commit .env.local — it's gitignored).
# EXPO_PUBLIC_* vars are baked in at Metro bundler startup — restart `expo start`
# after changing this file.

# Base URL of the FastAPI backend.
# Development: use your machine's LAN IP so a physical device/emulator can reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Production (when deployed):
# EXPO_PUBLIC_API_URL=https://api.njangui.cm
